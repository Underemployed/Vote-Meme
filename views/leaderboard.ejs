<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Leaderboard - Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen">
  <!-- Header -->
  <div class="bg-white shadow">
    <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
      <h1 class="text-2xl font-bold text-gray-800">🏆 Leaderboard</h1>
      <div class="flex items-center gap-4">
        <a href="/add-post" class="text-blue-600 hover:text-blue-700 font-semibold">Add Poster</a>
        <a href="/index" class="text-gray-600 hover:text-gray-700">View Posts</a>
        <a href="/logout" class="text-red-600 hover:text-red-700 font-semibold">Logout</a>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="max-w-6xl mx-auto px-4 py-8">
    <% if (leaderboard.length === 0) { %>
      <div class="text-center py-20">
        <div class="text-6xl mb-4">📊</div>
        <h2 class="text-2xl font-bold text-gray-800 mb-2">No data yet</h2>
        <p class="text-gray-600">Add some posters to get started!</p>
        <a href="/add-post" class="inline-block mt-4 bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition">
          Add First Poster
        </a>
      </div>
    <% } else { %>
      <div class="space-y-6">
        <% leaderboard.forEach((entry, index) => { %>
          <div class="bg-white rounded-lg shadow-lg overflow-hidden">
            <!-- Name Header -->
            <div 
              class="p-6 cursor-pointer hover:bg-gray-50 transition flex items-center justify-between"
              onclick="togglePosters('<%= entry._id %>')"
            >
              <div class="flex items-center gap-4">
                <!-- Rank Badge -->
                <div class="flex-shrink-0">
                  <% if (index === 0) { %>
                    <span class="text-4xl">🥇</span>
                  <% } else if (index === 1) { %>
                    <span class="text-4xl">🥈</span>
                  <% } else if (index === 2) { %>
                    <span class="text-4xl">🥉</span>
                  <% } else { %>
                    <span class="text-2xl font-bold text-gray-400">#<%= index + 1 %></span>
                  <% } %>
                </div>

                <!-- Name and Stats -->
                <div>
                  <h2 class="text-2xl font-bold text-gray-800"><%= entry._id %></h2>
                  <div class="flex items-center gap-4 mt-1">
                    <span class="text-green-600 font-semibold flex items-center gap-1">
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                      </svg>
                      <%= entry.totalLikes %> Likes
                    </span>
                    <span class="text-red-600 font-semibold flex items-center gap-1">
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                      </svg>
                      <%= entry.totalDislikes %> Dislikes
                    </span>
                    <span class="text-gray-500 text-sm">
                      <%= entry.posters.length %> poster<%= entry.posters.length !== 1 ? 's' : '' %>
                    </span>
                  </div>
                </div>
              </div>

              <!-- Expand Arrow -->
              <svg 
                id="arrow-<%= entry._id %>" 
                class="w-6 h-6 text-gray-400 transform transition-transform"
                fill="none" 
                stroke="currentColor" 
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>

            <!-- Individual Posters (Collapsible) -->
            <div id="posters-<%= entry._id %>" class="hidden border-t border-gray-200">
              <div class="p-6 bg-gray-50">
                <h3 class="text-lg font-semibold text-gray-700 mb-4">Individual Posters</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                  <% entry.posters.forEach(poster => { %>
                    <div class="bg-white rounded-lg shadow overflow-hidden">
                      <img 
                        src="<%= poster.imageUrl %>" 
                        alt="Poster"
                        class="w-full h-48 object-cover"
                      >
                      <div class="p-4">
                        <div class="flex items-center justify-between text-sm">
                          <span class="text-green-600 font-semibold flex items-center gap-1">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                            </svg>
                            <%= poster.likes %>
                          </span>
                          <span class="text-red-600 font-semibold flex items-center gap-1">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                            <%= poster.dislikes %>
                          </span>
                        </div>
                        <% const total = poster.likes + poster.dislikes %>
                        <% if (total > 0) { %>
                          <div class="mt-2">
                            <div class="flex justify-between text-xs text-gray-600 mb-1">
                              <span><%= Math.round((poster.likes / total) * 100) %>% liked</span>
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-2">
                              <div 
                                class="bg-green-500 h-2 rounded-full transition-all"
                                style="width: <%= (poster.likes / total) * 100 %>%"
                              ></div>
                            </div>
                          </div>
                        <% } %>
                      </div>
                    </div>
                  <% }); %>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <script>
    function togglePosters(id) {
      const postersDiv = document.getElementById('posters-' + id);
      const arrow = document.getElementById('arrow-' + id);
      
      if (postersDiv.classList.contains('hidden')) {
        postersDiv.classList.remove('hidden');
        arrow.classList.add('rotate-180');
      } else {
        postersDiv.classList.add('hidden');
        arrow.classList.remove('rotate-180');
      }
    }
  </script>
</body>
</html>
