<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Panel - Poster Competition</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      padding: 20px;
    }
    
    .container {
      max-width: 1200px;
      margin: 0 auto;
    }
    
    header {
      text-align: center;
      color: white;
      margin-bottom: 30px;
    }
    
    header h1 {
      font-size: 2.5em;
      margin-bottom: 10px;
    }
    
    .back-link {
      text-align: center;
      margin-bottom: 20px;
    }
    
    .back-link a {
      background: white;
      color: #667eea;
      padding: 10px 25px;
      text-decoration: none;
      border-radius: 25px;
      font-weight: bold;
      display: inline-block;
    }
    
    .panel {
      background: white;
      border-radius: 15px;
      padding: 30px;
      margin-bottom: 30px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }
    
    .panel h2 {
      color: #667eea;
      margin-bottom: 20px;
      padding-bottom: 10px;
      border-bottom: 2px solid #667eea;
    }
    
    .form-group {
      margin-bottom: 20px;
    }
    
    .form-group label {
      display: block;
      margin-bottom: 5px;
      font-weight: bold;
      color: #333;
    }
    
    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      padding: 12px;
      border: 2px solid #ddd;
      border-radius: 5px;
      font-size: 16px;
      transition: border-color 0.3s;
    }
    
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: #667eea;
    }
    
    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    
    .btn {
      background: #667eea;
      color: white;
      border: none;
      padding: 12px 30px;
      border-radius: 25px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
      transition: all 0.3s;
    }
    
    .btn:hover {
      background: #5568d3;
      transform: scale(1.05);
    }
    
    .btn-danger {
      background: #e74c3c;
    }
    
    .btn-danger:hover {
      background: #c0392b;
    }
    
    .participants-list {
      max-height: 300px;
      overflow-y: auto;
      margin-top: 20px;
    }
    
    .participant-item {
      padding: 10px;
      border-bottom: 1px solid #eee;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    
    .participant-item:hover {
      background: #f8f9fa;
    }
    
    .posters-table {
      width: 100%;
      margin-top: 20px;
      border-collapse: collapse;
    }
    
    .posters-table th,
    .posters-table td {
      padding: 12px;
      text-align: left;
      border-bottom: 1px solid #ddd;
    }
    
    .posters-table th {
      background: #667eea;
      color: white;
    }
    
    .posters-table tr:hover {
      background: #f8f9fa;
    }
    
    .poster-thumbnail {
      width: 80px;
      height: 80px;
      object-fit: cover;
      border-radius: 5px;
    }
    
    .success-message {
      background: #2ecc71;
      color: white;
      padding: 15px;
      border-radius: 5px;
      margin-bottom: 20px;
      display: none;
    }
    
    .error-message {
      background: #e74c3c;
      color: white;
      padding: 15px;
      border-radius: 5px;
      margin-bottom: 20px;
      display: none;
    }
    
    @media (max-width: 768px) {
      .form-row {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>📊 Admin Panel</h1>
      <p>Manage participants and upload posters</p>
    </header>
    
    <div class="back-link">
      <a href="/">← Back to Gallery</a>
    </div>
    
    <div id="successMessage" class="success-message"></div>
    <div id="errorMessage" class="error-message"></div>
    
    <!-- Add Participant Panel -->
    <div class="panel">
      <h2>➕ Add New Participant</h2>
      <form id="addParticipantForm">
        <div class="form-row">
          <div class="form-group">
            <label for="name">Name *</label>
            <input type="text" id="name" name="name" required>
          </div>
          <div class="form-group">
            <label for="email">Email *</label>
            <input type="email" id="email" name="email" required>
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label for="phone">Phone</label>
            <input type="tel" id="phone" name="phone">
          </div>
          <div class="form-group">
            <label for="department">Department</label>
            <input type="text" id="department" name="department" placeholder="e.g., CE, ECE, IT">
          </div>
        </div>
        
        <div class="form-group">
          <label for="year">Year</label>
          <select id="year" name="year">
            <option value="">Select Year</option>
            <option value="1st Year">1st Year</option>
            <option value="2nd Year">2nd Year</option>
            <option value="3rd Year">3rd Year</option>
            <option value="4th Year">4th Year</option>
          </select>
        </div>
        
        <button type="submit" class="btn">Add Participant</button>
      </form>
      
      <div class="participants-list">
        <h3 style="margin-top: 20px; margin-bottom: 10px;">Current Participants (<%= participants.length %>)</h3>
        <% participants.forEach(participant => { %>
          <div class="participant-item">
            <div>
              <strong><%= participant.name %></strong> - 
              <%= participant.email %>
              <% if (participant.department) { %>
                (<%= participant.department %> - <%= participant.year %>)
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
    
    <!-- Upload Poster Panel -->
    <div class="panel">
      <h2>📤 Upload Poster</h2>
      <form id="uploadPosterForm" enctype="multipart/form-data">
        <div class="form-group">
          <label for="participantSelect">Select Participant *</label>
          <select id="participantSelect" name="participantId" required>
            <option value="">Choose a participant...</option>
            <% participants.forEach(participant => { %>
              <option value="<%= participant._id %>">
                <%= participant.name %> 
                <% if (participant.department) { %>
                  - <%= participant.department %> <%= participant.year %>
                <% } %>
              </option>
            <% }); %>
          </select>
        </div>
        
        <div class="form-group">
          <label for="posterFile">Poster Image *</label>
          <input type="file" id="posterFile" name="poster" accept="image/*,application/pdf" required>
        </div>
        
        <div class="form-group">
          <label for="canvaLink">Canva Link (optional)</label>
          <input type="url" id="canvaLink" name="canvaLink" placeholder="https://www.canva.com/design/...">
        </div>
        
        <button type="submit" class="btn">Upload Poster</button>
      </form>
    </div>
    
    <!-- Uploaded Posters List -->
    <div class="panel">
      <h2>📋 Uploaded Posters (<%= posters.length %>)</h2>
      <table class="posters-table">
        <thead>
          <tr>
            <th>Thumbnail</th>
            <th>Participant</th>
            <th>Department</th>
            <th>Likes</th>
            <th>Upload Date</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="postersTableBody">
          <% posters.forEach(poster => { %>
            <tr>
              <td>
                <% if (poster.imageUrl) { %>
                  <img src="<%= poster.imageUrl %>" class="poster-thumbnail" alt="Poster">
                <% } else { %>
                  <span>No image</span>
                <% } %>
              </td>
              <td><%= poster.participantName %></td>
              <td>
                <% if (poster.participantId.department) { %>
                  <%= poster.participantId.department %> - <%= poster.participantId.year %>
                <% } else { %>
                  -
                <% } %>
              </td>
              <td><%= poster.likes %> ❤️</td>
              <td><%= new Date(poster.uploadDate).toLocaleDateString() %></td>
              <td>
                <button class="btn btn-danger" onclick="deletePoster('<%= poster._id %>')">Delete</button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
  
  <script>
    // Add Participant
    document.getElementById('addParticipantForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = {
        name: document.getElementById('name').value,
        email: document.getElementById('email').value,
        phone: document.getElementById('phone').value,
        department: document.getElementById('department').value,
        year: document.getElementById('year').value
      };
      
      try {
        const response = await fetch('/api/participants', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(formData)
        });
        
        const data = await response.json();
        
        if (data.success) {
          showSuccess('Participant added successfully!');
          document.getElementById('addParticipantForm').reset();
          setTimeout(() => location.reload(), 1500);
        } else {
          showError(data.error || 'Failed to add participant');
        }
      } catch (err) {
        showError('Error: ' + err.message);
      }
    });
    
    // Upload Poster
    document.getElementById('uploadPosterForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData();
      formData.append('participantId', document.getElementById('participantSelect').value);
      formData.append('poster', document.getElementById('posterFile').files[0]);
      formData.append('canvaLink', document.getElementById('canvaLink').value);
      
      try {
        const response = await fetch('/api/upload', {
          method: 'POST',
          body: formData
        });
        
        const data = await response.json();
        
        if (data.success) {
          showSuccess('Poster uploaded successfully!');
          document.getElementById('uploadPosterForm').reset();
          setTimeout(() => location.reload(), 1500);
        } else {
          showError(data.error || 'Failed to upload poster');
        }
      } catch (err) {
        showError('Error: ' + err.message);
      }
    });
    
    // Delete Poster
    async function deletePoster(posterId) {
      if (!confirm('Are you sure you want to delete this poster?')) return;
      
      try {
        const response = await fetch(`/api/posters/${posterId}`, {
          method: 'DELETE'
        });
        
        const data = await response.json();
        
        if (data.success) {
          showSuccess('Poster deleted successfully!');
          setTimeout(() => location.reload(), 1000);
        } else {
          showError(data.error || 'Failed to delete poster');
        }
      } catch (err) {
        showError('Error: ' + err.message);
      }
    }
    
    function showSuccess(message) {
      const el = document.getElementById('successMessage');
      el.textContent = message;
      el.style.display = 'block';
      setTimeout(() => el.style.display = 'none', 5000);
    }
    
    function showError(message) {
      const el = document.getElementById('errorMessage');
      el.textContent = message;
      el.style.display = 'block';
      setTimeout(() => el.style.display = 'none', 5000);
    }
  </script>
</body>
</html>
