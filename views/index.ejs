<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Vote on Posters</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 min-h-screen">
  <!-- Header -->
  <div class="bg-gray-800 shadow-lg">
    <div class="max-w-4xl mx-auto px-4 py-4 flex justify-between items-center">
      <h1 class="text-2xl font-bold text-white">Poster Voting</h1>
      <div class="flex items-center gap-4">
        <span class="text-gray-300">Hi, <%= userName %>!</span>
        <a href="/logout" class="text-red-400 hover:text-red-300 font-semibold">Logout</a>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="max-w-4xl mx-auto px-4 py-8">
    <% if (posters.length === 0) { %>
      <div class="text-center py-20">
        <div class="text-6xl mb-4">🎉</div>
        <h2 class="text-3xl font-bold text-white mb-2">You've voted on all posters!</h2>
        <p class="text-gray-400">Check back later for new content.</p>
      </div>
    <% } else { %>
      <!-- Poster Card Container -->
      <div id="poster-container" class="relative">
        <% posters.forEach((poster, index) => { %>
          <div 
            class="poster-card absolute inset-0 transition-all duration-300"
            data-index="<%= index %>"
            data-poster-id="<%= poster._id %>"
            style="display: <%= index === 0 ? 'block' : 'none' %>;"
          >
            <div class="bg-gray-800 rounded-2xl shadow-2xl overflow-hidden max-w-2xl mx-auto">
              <!-- Image -->
              <div class="relative">
                <img 
                  src="<%= poster.imageUrl %>" 
                  alt="<%= poster.name %>'s poster"
                  class="w-full h-[600px] object-cover"
                >
                <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-6">
                  <h2 class="text-3xl font-bold text-white"><%= poster.name %></h2>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="p-8 flex justify-center items-center gap-8">
                <button 
                  onclick="vote('<%= poster._id %>', 'dislike')"
                  class="group bg-red-500 hover:bg-red-600 text-white rounded-full p-6 shadow-lg transition-all duration-200 hover:scale-110"
                >
                  <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path>
                  </svg>
                </button>

                <button 
                  onclick="vote('<%= poster._id %>', 'like')"
                  class="group bg-green-500 hover:bg-green-600 text-white rounded-full p-6 shadow-lg transition-all duration-200 hover:scale-110"
                >
                  <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                  </svg>
                </button>
              </div>

              <!-- Counter -->
              <div class="px-8 pb-6 text-center">
                <p class="text-gray-400">
                  <span id="current-count"><%= currentIndex + 1 %></span> / <%= posters.length %>
                </p>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <script>
    let currentIndex = 0;
    const posters = document.querySelectorAll('.poster-card');
    const totalPosters = posters.length;

    async function vote(posterId, voteType) {
      try {
        const response = await fetch('/api/vote', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ posterId, vote: voteType })
        });

        const result = await response.json();
        
        if (result.success) {
          // Show next poster
          showNextPoster();
        } else {
          alert(result.message || 'Error recording vote');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Error recording vote');
      }
    }

    function showNextPoster() {
      if (currentIndex < totalPosters - 1) {
        // Hide current poster
        posters[currentIndex].style.display = 'none';
        
        // Show next poster
        currentIndex++;
        posters[currentIndex].style.display = 'block';
        
        // Update counter
        document.getElementById('current-count').textContent = currentIndex + 1;
      } else {
        // All done!
        window.location.reload();
      }
    }

    // Keyboard shortcuts
    document.addEventListener('keydown', (e) => {
      if (totalPosters === 0) return;
      
      const currentPoster = posters[currentIndex];
      const posterId = currentPoster.dataset.posterId;
      
      if (e.key === 'ArrowLeft') {
        vote(posterId, 'dislike');
      } else if (e.key === 'ArrowRight') {
        vote(posterId, 'like');
      }
    });
  </script>
</body>
</html>
